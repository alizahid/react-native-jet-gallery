{
  "name": "react-native-jet-gallery",
  "version": "0.1.0",
  "description": "A photo gallery for React Native with shared-element transitions, multi-image paging with looping, GIF support, and custom actions. Powered by Nitro Modules.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src example/App.tsx example/src",
    "format": "biome check --write src example/App.tsx example/src",
    "test": "jest --passWithNoTests",
    "clean": "git clean -dfX",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen",
    "postcodegen": "npm --prefix example run pod"
  },
  "keywords": [
    "react-native",
    "gallery",
    "lightbox",
    "photo",
    "image-viewer",
    "shared-element",
    "nitro"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/alizahid/react-native-jet-gallery.git",
  "author": "Ali Zahid",
  "license": "MIT",
  "bugs": "https://github.com/alizahid/react-native-jet-gallery/issues",
  "homepage": "https://github.com/alizahid/react-native-jet-gallery#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.36.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.36.1",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
