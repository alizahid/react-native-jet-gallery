{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "jetgallery"
  ],
  "ios": {
    "iosModuleName": "JetGallery"
  },
  "android": {
    "androidNamespace": [
      "jetgallery"
    ],
    "androidCxxLibName": "JetGallery"
  },
  "autolinking": {
    "GalleryController": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridGalleryController"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
